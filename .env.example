# Copy to .env and fill in. Run `node build.js` after every change.

# Any page on the site holding the Join queue button. Paste a campaign link
# straight from the address bar; only the domain is used, so a link that later
# points at a different campaign needs no change here.
# https://app.yoursite.com/campaigns/abc-123  ->  covers all of app.yoursite.com
SITE_URL=https://REPLACE-ME.example.com/

# Give up after this many clicks.
MAX_ATTEMPTS=200

# After a "queue is full" answer, wait a random time in this range before
# reloading and retrying. Decimals are fine. Set both to the same value for a
# fixed interval.
RETRY_INTERVAL_MIN_SECONDS=5
RETRY_INTERVAL_MAX_SECONDS=10

# Give up if the server sends no joinTaskQueue answer within this window.
RESPONSE_TIMEOUT_SECONDS=15

# Settle time after the page loads, before looking for the button.
# Decimals are fine. Use 0 to click as soon as possible.
CLICK_DELAY_SECONDS=1
