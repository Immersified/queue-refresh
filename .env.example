# Copy to .env and fill in. Run `node build.js` after every change.

# The page holding the Join queue button. A URL match pattern.
# Examples: https://app.yoursite.com/*   or   https://app.yoursite.com/queues/*
SITE_URL=https://REPLACE-ME.example.com/*

# Give up after this many clicks.
MAX_ATTEMPTS=200

# Wait this long after a "queue is full" answer before reloading and retrying.
RETRY_INTERVAL_SECONDS=10

# Give up if the server sends no joinTaskQueue answer within this window.
RESPONSE_TIMEOUT_SECONDS=15
