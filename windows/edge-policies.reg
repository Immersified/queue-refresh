Windows Registry Editor Version 5.00

; Sleeping tabs discard a tab after a couple of hours. A discarded queue tab
; has no timers, no content script and nothing to screenshot.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"SleepingTabsEnabled"=dword:00000000
"EfficiencyModeEnabled"=dword:00000000
"BackgroundModeEnabled"=dword:00000001
